# Copy this file to ".env" and fill in your own values. Never share the .env file.

# --- Demo mode (recommended for the hackathon) ---------------------------
# Generates SAMPLE fares so anyone can run the full flow. Not real prices.
DEMO_MODE=true

# --- AI (pick one; with none, a basic built-in reader is used) -----------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Free option (Groq):  OPENAI_API_URL=https://api.groq.com/openai  and  OPENAI_MODEL=openai/gpt-oss-120b

# --- PayPal sandbox (free): https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# PayPal cannot charge naira. Checkout is charged in US dollars at this rate:
NGN_PER_USD=1500

# --- Real flight data (optional) ------------------------------------------
# Duffel test token from https://app.duffel.com/ (test mode gives fake flights)
DUFFEL_ACCESS_TOKEN=

# --- Accounts and saved chats ---------------------------------------------
# Any long random text. Keeps sign-in cookies safe. If you leave it empty, one is made for you.
SESSION_SECRET=
# Where accounts and chats are kept (default: data/store.json). On Render's free plan this
# disk is wiped on redeploy, so accounts can reset. A real launch needs a database.
# DATA_FILE=

# --- Email (sends the 6-digit sign-up code) ------------------------------
# Free: create a Brevo account (brevo.com), verify your sender email there, make an API key (SMTP & API).
BREVO_API_KEY=
MAIL_FROM=
# MAIL_FROM_NAME=FlightScout
# Or use Resend instead:  RESEND_API_KEY=  (MAIL_FROM must be on a domain you verified there)
# Or send from your own Gmail with a free Google Apps Script (see GMAIL-SETUP.md):
# GAS_MAIL_URL=
# GAS_MAIL_SECRET=
# With no email set up, this shows the code on screen so you can still test locally:
SHOW_CODE_ON_SCREEN=true

# --- Keep accounts when the host's disk is wiped (free, optional) -----------
# Create a free Redis database at upstash.com and paste its REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

PORT=3000
